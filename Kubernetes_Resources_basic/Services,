1) ClusterIp.yml ---Local data transfer can be done with ClusterIP - For internal communication


apiVersion: v1
kind: Service
metadata:
  name: webserver-service
  namespace: web
spec:
  type: ClusterIP
  selector:
    app: webserver
  ports:
  - port: 80
    targetPort: 80

